<%- include('partials/head', { title: 'Account' }) %>
<section class="card narrow">
  <h1>Your account</h1>
  <p class="muted">Signed in as <%= user.email %></p>
  <form method="post" action="/account" class="stack">
    <h2>Change password</h2>
    <label><span>Current password</span><input type="password" name="current" autocomplete="current-password" required></label>
    <label><span>New password (8+ characters)</span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
    <button class="btn">Change password</button>
  </form>
  <% if (user.role === 'agent') { %><p class="muted small">Your name, phone, photo and colors are under <a href="/admin/settings">Branding</a>.</p><% } %>
</section>
<%- include('partials/foot') %>
