<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= title %> · <%= brand %></title>
<link rel="icon" href="/favicon.png">
<link rel="stylesheet" href="/style.css">
<% if (theme.primary || theme.accent) { %><style>:root {<% if (theme.primary) { %> --brand: <%= theme.primary %>; --brand-ink: <%= theme.ink %>;<% } %><% if (theme.accent) { %> --gold: <%= theme.accent %>;<% } %> }</style><% } %>
</head>
<body class="<%= typeof bodyClass === 'string' ? bodyClass : '' %>">
<header class="top">
  <a class="brand" href="/"><img src="<%= site.logo ? '/brand/' + site.logo : '/logo.png' %>" alt="<%= brand %>"><small>Client Portal</small></a>
  <% if (user) { %>
  <nav>
    <% if (user.role === 'agent') { %><a href="/admin">Dashboard</a><a href="/admin/learn">Learn</a><a href="/admin/vendors">Trusted pros</a><a href="/admin/settings">Settings</a>
    <% } else if (!user.is_lender) { %><a href="/portal">My home</a><a href="/learn">Learn</a><% if (hasVendors) { %><a href="/vendors">Trusted pros</a><% } %><% } %>
    <a href="/account"><%= user.name.split(' ')[0] %>’s account</a>
    <form method="post" action="/logout"><button class="link">Sign out</button></form>
  </nav>
  <% } %>
</header>
<main>
<% if (typeof flash === 'string' && flash) { %><p class="flash" role="status"><%= flash %></p><% } %>
<% if (error) { %><p class="flash err" role="alert"><%= error %></p><% } %>
