<div class="fields">
<% def.fields.forEach(function (f) {
     if (f.type === 'heading') { %><h3 class="wide"><%= f.label %></h3><% return; }
     var v = r[f.name] == null ? (f.default === 'today' ? today : '') : r[f.name]; %>
  <label class="<%= f.wide ? 'wide' : '' %>"><span><%= f.label %><%= f.required ? ' *' : '' %></span>
  <% if (f.type === 'select') { %>
    <select name="<%= f.name %>">
    <% f.options.forEach(function (o) { var val = Array.isArray(o) ? o[0] : o, lab = Array.isArray(o) ? o[1] : o; %>
      <option value="<%= val %>" <%= String(v) === String(val) ? 'selected' : '' %>><%= lab %></option>
    <% }) %>
    </select>
  <% } else if (f.type === 'textarea') { %>
    <textarea name="<%= f.name %>" rows="3" <%= f.required ? 'required' : '' %>><%= v %></textarea>
  <% } else { %>
    <input type="<%= f.type === 'money' || f.type === 'percent' ? 'number' : f.type %>" name="<%= f.name %>" value="<%= v %>"
      <%= f.required ? 'required' : '' %> <%- f.type === 'money' ? 'min="0" step="1" inputmode="numeric" placeholder="$"' : f.type === 'percent' ? 'min="0" max="100" step="any" inputmode="decimal" placeholder="%"' : f.type === 'number' ? 'min="0" step="any"' : '' %>
      <% if (f.list) { %>list="list-<%= f.name %>"<% } %>>
    <% if (f.list) { %><datalist id="list-<%= f.name %>"><% f.list.forEach(function (o) { %><option value="<%= o %>"><% }) %></datalist><% } %>
  <% } %>
  </label>
<% }) %>
</div>
